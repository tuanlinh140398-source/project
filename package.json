{
  "name": "course-registration-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Viettel Academy - Course Registration API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute course-registration-db --remote --file ./db/migrations/001_create_registrations.sql",
    "db:migrate:local": "wrangler d1 execute course-registration-db --local --file ./db/migrations/001_create_registrations.sql"
  },
  "dependencies": {
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240605.1",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/uuid": "^9.0.2",
    "typescript": "^5.1.3",
    "vitest": "^0.34.1",
    "wrangler": "^3.12.0"
  }
}
